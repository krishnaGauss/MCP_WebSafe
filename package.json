{
  "name": "geo-shield-mcp",
  "version": "0.1.0",
  "description": "Defensive MCP server that detects website manipulation aimed at search engines and AI assistants (GEO integrity scanner).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "geo-shield-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node --experimental-strip-types tests/fixtures/serve.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "ipaddr.js": "^2.5.0",
    "pino": "^10.4.0",
    "tldts": "^7.4.24",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
