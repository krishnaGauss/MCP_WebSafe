# Path of the SQLite database used to store scans (default: ./data/geo-shield.db)
GEO_SHIELD_DB_PATH=./data/geo-shield.db
# Log level written to stderr (stdout is reserved for the MCP protocol)
GEO_SHIELD_LOG_LEVEL=info
# Per-request timeout in milliseconds
GEO_SHIELD_FETCH_TIMEOUT_MS=10000
# Maximum response body read per page, in bytes (larger bodies are truncated and flagged)
GEO_SHIELD_MAX_BODY_BYTES=2097152
# Extra destination ports to allow besides 80 and 443 (comma separated)
GEO_SHIELD_ALLOWED_PORTS=
# Days to keep stored scans before they are purged at startup (0 = keep forever)
GEO_SHIELD_RETENTION_DAYS=30
# TEST ONLY: comma-separated host:port pairs on loopback that may be fetched (local fixture server).
# Never set this for normal use: it is the only way the SSRF guard lets a loopback address through.
GEO_SHIELD_FIXTURE_ALLOW=
